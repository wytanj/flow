# ---------------------------------------------------------------------------
# Required: Postgres. Anything with pgvector available works.
# ---------------------------------------------------------------------------
# Supabase (local dev uses the session pooler, port 5432)
SUPABASE_POOLER=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Or any Postgres at all — this takes precedence when set:
# FLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flow
#
# Deploying serverless? Point FLOW_DATABASE_URL at Supabase's TRANSACTION
# pooler (port 6543). Concurrent invocations exhaust session-mode connections.

# ---------------------------------------------------------------------------
# Required for the HTTP API and remote MCP. Not needed for CLI or stdio MCP.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
FLOW_API_TOKEN=
FLOW_API_PORT=8787
FLOW_API_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Optional: chat model. Powers /jot and /ask only.
# Any OpenAI-compatible endpoint. Leave unset and those two features are off;
# everything else — capture, recall, shelves, MCP — works without it.
# ---------------------------------------------------------------------------
# FLOW_LLM_URL=https://api.x.ai/v1          # or api.openai.com/v1, openrouter, …
# FLOW_LLM_KEY=
# FLOW_MODEL=grok-4.5
#
# Fully local, no key needed:
# FLOW_LLM_URL=http://localhost:11434/v1
# FLOW_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# Optional: embeddings. Unset means recall is full-text only, which works fine.
# The index records which provider built it and refuses to mix vector spaces.
# After setting: npm run embeddings:sync   (add --rebuild when changing provider)
# ---------------------------------------------------------------------------
# FLOW_EMBEDDINGS=ollama:qwen3-embedding:0.6b    # local, Apache 2.0, no key
# FLOW_EMBEDDINGS=gemini:gemini-embedding-001    # hosted, ~1500 free req/day
# FLOW_EMBEDDINGS=openai:text-embedding-3-small
# GEMINI_API_KEY=
# FLOW_EMBEDDINGS_KEY=
# FLOW_EMBEDDINGS_URL=                # OpenAI-shaped endpoint (LM Studio, TEI, vLLM…)
# FLOW_EMBEDDINGS_DIM=                # truncate output dims; gemini defaults to 1536
# FLOW_EMBEDDINGS_MAX_DISTANCE=       # relevance ceiling; 0.42 gemini, 0.6 others
# FLOW_EMBEDDINGS_MARGIN=             # keep hits within this of the best (default 0.08)

# ---------------------------------------------------------------------------
# Optional: research — powers "catch up", which looks up what changed in the
# world and appends it as a dated, sourced note. Two shapes:
#
#   retrieval (preferred)  Exa. You give the query and filters; the date window
#                          is enforced by the index, not asked for in a prompt.
#                          Faster, and better at spotting pivots.
#   agentic (fallback)     the chat model's own hosted web_search (xAI/OpenAI).
#                          No extra key, but slower and the date filter is
#                          only a request.
#
# Auto-selects Exa when EXA_API_KEY is set. Force with FLOW_RESEARCH.
# ---------------------------------------------------------------------------
# EXA_API_KEY=
# FLOW_RESEARCH=            # exa | agentic | off   (default: auto)
# EXA_SEARCH_TYPE=auto      # instant | fast | auto | deep | deep-reasoning
# FLOW_RESEARCH_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Optional: integrations — pull in things you collected elsewhere.
#   npm run sync            list them
#   npm run sync -- github  import starred repos (safe to re-run)
# ---------------------------------------------------------------------------
# GITHUB_USER=              # public stars, no token needed
# GITHUB_TOKEN=             # adds private stars, 5000/hr instead of 60

# ---------------------------------------------------------------------------
# Optional: Telegram bot. Dormant until BOT_TOKEN is set.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_CHAT_IDS=
